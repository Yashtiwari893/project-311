# ── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Razorpay Plan IDs (create in Razorpay dashboard)
RAZORPAY_PLAN_STARTER=plan_xxxxxxxxxxxx   # ₹2,999/mo
RAZORPAY_PLAN_PRO=plan_xxxxxxxxxxxx       # ₹6,999/mo
RAZORPAY_PLAN_AGENCY=plan_xxxxxxxxxxxx    # ₹14,999/mo

RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@linkedflow.in

# ── AI ──────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# ── GitHub Actions (Automation) ─────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=linkedflow-runner
WEBHOOK_SECRET=your-webhook-secret
